---
import Demo from './Demo.astro';
import Icon from './Icon.astro';
import StoreLinks from './StoreLinks.astro';
import { cities, faqs, asset, type Lang } from '../data/site';
import flights from '../data/flights.json';
const { lang = 'en' } = Astro.props as { lang: Lang };
const c = (en: string, ko: string) => (lang === 'ko' ? ko : en);
const classes = ['ECONOMY', 'ECONOMY+', 'BUSINESS', 'FIRST', 'CHARTER'];
const motif = [
  '0000000000',
  '0000000000',
  '0000110000',
  '0011110222',
  '0011111222',
  '1111111222',
  '1111111222',
  '1111111222',
  '0000000000',
  '1111222333',
];
const comfort = [
  [
    'hand',
    c('One hand, at ease', '한 손으로 편하게'),
    c('Move the board and controls to your side.', '보드와 도구를 편한 쪽에 두세요.'),
  ],
  [
    'moon',
    c('Night flight', '야간 비행'),
    c('A quieter palette for the later hours.', '늦은 시간에는 차분한 색으로.'),
  ],
  [
    'offline',
    c('Ready for airplane mode', '비행기 모드에서도'),
    c('Puzzles, hints and your album work offline.', '퍼즐, 힌트, 앨범을 오프라인으로.'),
  ],
  [
    'globe',
    c('Two familiar languages', '익숙한 두 언어'),
    c('English and Korean, throughout the app.', '앱 전체를 한국어와 영어로.'),
  ],
  [
    'save',
    c('Right where you left off', '멈췄던 그 칸에서'),
    c('Your progress saves as you go.', '플레이하는 동안 진행을 자동 저장해요.'),
  ],
  [
    'tune',
    c('Your flight, your controls', '나에게 맞는 비행'),
    c(
      'Autopilot feedback, or manual flight without error rings.',
      '자동 항법 또는 수동 비행을 선택하세요.',
    ),
  ],
  [
    'eye',
    c('More than colour', '색 너머의 단서'),
    c('Numbers and patterns help tell inks apart.', '번호와 패턴으로 잉크를 구분해요.'),
  ],
  [
    'book',
    c('Clues that can be read aloud', '소리로 읽는 단서'),
    c('Cells describe their row, column and state.', '칸의 행, 열, 상태를 읽어줍니다.'),
  ],
];
---

<section class="hero" id="try" aria-labelledby="hero-heading">
  <div class="hero-sky" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="airdata accent">NONOGRAM TRIP · WINDOW SEAT PUZZLES</p>
      <h1 id="hero-heading">
        {c('Every puzzle is a place you’ve been.', '퍼즐 하나가 다녀왔던 곳이 됩니다.')}
      </h1>
      <p class="hero-description">
        {c(
          'Board 192 flights across twelve cities. Read the clues, fill the grid, and the view outside your window develops into a photo for your album.',
          '열두 도시, 192편의 항공편에 탑승합니다. 숫자를 읽어 격자를 채우면 창밖 풍경이 앨범에 남을 사진으로 현상됩니다.',
        )}
      </p>
      <StoreLinks lang={lang} position="hero" />
      <p class="release-note">
        {c(
          'The app is preparing for takeoff. Your first puzzle is right here.',
          '앱은 이륙을 준비 중입니다. 첫 퍼즐은 여기서 시작하세요.',
        )}
      </p>
      <a class="text-link" href="#route">
        {c('What makes it different?', '무엇이 다른가요?')} <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-demo">
      <Demo lang={lang} />
    </div>
  </div>
</section>
<div class="sticky-sentinel" aria-hidden="true"></div>
<section class="trust-strip" aria-label={c('App information', '앱 정보')}>
  <div class="container trust-inner">
    <span class="trust-brand">
      <img src={asset('app-icon-small.webp')} width="34" height="34" alt="" />
      {c('Made for a little escape.', '잠깐의 여행을 위해.')}
    </span>
    <span class="airdata">ANDROID 8.0+ · iOS 15+</span>
    <span class="airdata">EN / KO</span>
    <span class="airdata">{c('NO ACCOUNT NEEDED', '회원가입 없이')}</span>
  </div>
</section>
<section class="section departures" id="departures">
  <div class="container departures-grid">
    <div class="departure-copy">
      <p class="airdata accent">DEPARTURES · HKG</p>
      <h2>{c('Not three stars. A boarding class.', '별 세 개가 아니라, 탑승 클래스입니다.')}</h2>
      <p>
        {c(
          'Some flights are a gentle beginning. Others ask you to look a little closer. Difficulty follows the logic you need, not just the size of the grid.',
          '가볍게 시작하는 비행부터 한 번 더 생각하게 하는 비행까지. 격자 크기보다 필요한 논리 기법으로 난이도를 정했습니다.',
        )}
      </p>
      <div class="class-legend">
        {classes.map((name, i) => (
          <span>
            <i>{String(i + 1).padStart(2, '0')}</i>
            {name}
          </span>
        ))}
      </div>
      <p class="caption">
        {c(
          '16 flights in every city. A weekly charter when you want a new challenge.',
          '도시마다 16편. 새로운 도전이 필요할 때는 주간 차터편도 기다립니다.',
        )}
      </p>
    </div>
    <div class="departure-board">
      <div class="board-title">
        <span>DEPARTURES</span>
        <Icon name="plane" />
        <span class="board-code">HKG</span>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">
            {c('The sixteen Hong Kong puzzles in the app', '앱의 홍콩 퍼즐 16편')}
          </caption>
          <thead>
            <tr>
              <th>{c('FLIGHT', '편명')}</th>
              <th>{c('GRID', '격자')}</th>
              <th>{c('CLASS', '클래스')}</th>
              <th>{c('DEST', '도착지')}</th>
            </tr>
          </thead>
          <tbody>
            {flights.map((f, i) => (
              <tr style={`--i:${i}`}>
                <td>{f.id}</td>
                <td>{f.size}</td>
                <td class:list={['flight-class', { 'is-charter': i === 15 }]}>
                  {i === 15 ? 'CHARTER' : classes[f.difficulty - 1]}
                </td>
                <td>HKG</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="board-footer airdata">
        <span>12 CITIES · 192 FLIGHTS</span>
        <span>{c('TAKE YOUR TIME', '서두르지 않아도 괜찮아요')}</span>
      </div>
    </div>
  </div>
</section>
<section class="section route-section" id="route" data-city="icn" aria-labelledby="route-heading">
  <div class="container">
    <div class="section-heading">
      <p class="airdata accent">YOUR ROUTE · 12 CITIES</p>
      <h2 id="route-heading">
        {c('A different city. A different kind of colour.', '도시가 바뀌면, 풍경의 색도 바뀝니다.')}
      </h2>
      <p>
        {c(
          'Twelve regions, sixteen flights each. Every destination has its own palette, and a place in your album. Pick your next window view.',
          '열두 구역, 구역마다 열여섯 편. 도시는 저마다의 팔레트로 앨범에 남습니다. 다음 창밖 풍경을 골라보세요.',
        )}
      </p>
    </div>
    <div class="route-line" aria-hidden="true">
      <svg viewBox="0 0 1100 90" preserveAspectRatio="none">
        <path
          class="route-path"
          d="M10 65 C180 15 320 105 520 50 C720 0 870 5 1090 60"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          pathLength="1"
        />
      </svg>
      <span>
        <Icon name="plane" size={26} />
      </span>
    </div>
    <div
      class="city-tabs"
      role="tablist"
      aria-label={c('Choose a destination', '여행할 도시 선택')}
    >
      {cities.map((city, i) => (
        <button
          id={`tab-${city.code.toLowerCase()}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`city-${city.code.toLowerCase()}`}
          tabindex={i === 0 ? 0 : -1}
          data-code={city.code.toLowerCase()}
        >
          <span class="city-dot" style={`--dot:${city.colors[0]}`}></span>
          <strong>{city.code}</strong>
          <span>{city[lang]}</span>
        </button>
      ))}
    </div>
    <div class="route-panels">
      {cities.map((city, i) => (
        <div
          id={`city-${city.code.toLowerCase()}`}
          class="city-panel"
          role="tabpanel"
          aria-labelledby={`tab-${city.code.toLowerCase()}`}
          hidden={i !== 0}
          tabindex="0"
        >
          <div class="city-photo">
            <img
              src={i === 0 ? asset(`city-${city.code.toLowerCase()}.avif`) : undefined}
              data-src={asset(`city-${city.code.toLowerCase()}.avif`)}
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
              alt={lang === 'ko' ? `${city.ko}의 여행 일러스트` : `Illustrated view of ${city.en}`}
            />
            <div class="photo-ticket">
              <span class="airdata">{String(i + 1).padStart(2, '0')} / 12</span>
              <strong>{city.code}</strong>
              <span>{city[lang]}</span>
              <span class="airdata">16 FLIGHTS</span>
            </div>
          </div>
          <div class="city-story">
            <span class="airdata">WINDOW SEAT · {city.code}</span>
            <h3>{city[lang === 'ko' ? 'themeKo' : 'themeEn']}</h3>
            <p>
              {c(
                'One view to discover. Sixteen little reasons to stay.',
                '발견하고 싶은 풍경 하나. 조금 더 머무르고 싶은 열여섯 가지 이유.',
              )}
            </p>
            <div class="swatches" aria-label={c('City colour palette', '도시 팔레트')}>
              {city.colors.map((color) => (
                <span style={`background:${color}`}>
                  <span class="sr-only">{color}</span>
                </span>
              ))}
            </div>
            <div
              class="city-puzzle"
              aria-hidden="true"
              style={`--c1:${city.colors[0]};--c2:${city.colors[1]};--c3:${city.colors[2]}`}
            >
              {motif
                .join('')
                .split('')
                .map((v) => (
                  <i style={`background:${v === '0' ? 'transparent' : `var(--c${v})`}`} />
                ))}
            </div>
            <span class="caption">{c('A palette preview', '도시 색 미리보기')}</span>
          </div>
        </div>
      ))}
    </div>
    <p class="route-foot caption">
      {c(
        'Choose a city to explore its colours. Your puzzle above stays just as you left it.',
        '도시를 골라 색을 둘러보세요. 위에서 풀던 퍼즐은 그대로 기다립니다.',
      )}
    </p>
    <noscript>
      <p>
        {c(
          'Enable JavaScript to switch cities. Your first view is Seoul.',
          '도시를 바꾸려면 JavaScript를 켜 주세요. 첫 풍경은 서울입니다.',
        )}
      </p>
    </noscript>
  </div>
</section>
<section class="section develop-section" id="develop">
  <div class="container develop-layout">
    <div class="develop-art">
      <div class="development-frame">
        <div class="develop-image" data-develop style="--develop:50%">
          <img
            src={asset('city-hkg.avif')}
            alt={c('Hong Kong’s harbour coming into colour', '색이 입혀지는 홍콩의 항구')}
            width="1600"
            height="900"
            loading="lazy"
          />
          <div class="develop-colour-pixels" aria-hidden="true">
            {motif
              .join('')
              .split('')
              .map((v) => (
                <i style={`background:${v === '0' ? '#f2ede2' : 'transparent'}`} />
              ))}
          </div>
          <div class="develop-mono" aria-hidden="true">
            <div class="develop-ink-pixels">
              {motif
                .join('')
                .split('')
                .map((v) => (
                  <i style={`background:${v === '0' ? '#f2ede2' : '#12222e'}`} />
                ))}
            </div>
          </div>
          <span class="develop-line" aria-hidden="true"></span>
          <span class="arrival-stamp" aria-hidden="true">
            ARRIVED<small>HKG · WINDOW SEAT</small>
          </span>
        </div>
        <div class="develop-caption">
          <strong>{c('Harbour lights', '항구의 불빛')}</strong>
          <span class="airdata">HONG KONG · HKG</span>
        </div>
      </div>
      <label class="range-label" for="develop-range">
        <span>{c('Develop the view', '풍경에 색 입히기')}</span>
        <output id="develop-value" for="develop-range">
          50%
        </output>
      </label>
      <input
        id="develop-range"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label={c('Develop amount', '채색 정도')}
      />
      <p class="caption">
        {c(
          'Slide to see the colour come through.',
          '슬라이더를 움직여 색이 스며드는 모습을 보세요.',
        )}
      </p>
    </div>
    <div class="develop-copy">
      <p class="airdata accent">FROM LOGIC TO A MEMORY</p>
      <h2>
        {c('Fill the last cell. Let the colour in.', '마지막 칸을 채우면, 도시의 색이 스며듭니다.')}
      </h2>
      <p>
        {c(
          'Follow the clues, one square at a time. Finish the puzzle and it becomes a little photograph in the city’s colours, ready for your album.',
          '숫자를 따라 한 칸씩 채워보세요. 완성한 퍼즐은 그 도시의 색을 담은 작은 사진이 되어 앨범에 남습니다.',
        )}
      </p>
      <div class="arrival-steps">
        <div>
          <span class="small-stamp">
            ARRIVED
            <br />
            <small>HKG</small>
          </span>
          <span>{c('Make your landing', '도착을 기록하고')}</span>
        </div>
        <Icon name="arrow" />
        <div>
          <img src={asset('prop_polaroids.webp')} width="94" height="72" alt="" loading="lazy" />
          <span>{c('Keep the memory', '추억을 모으세요')}</span>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section learn-section" id="learn">
  <div class="container learn-layout">
    <div>
      <p class="airdata accent">SMART HINT · THREE SMALL STEPS</p>
      <h2>{c('Learn to see the next move.', '정답보다, 다음 수를 읽는 법.')}</h2>
      <p>
        {c(
          'A good hint does more than fill a square. It shows where to look, explains the logic, then lets you see what is certain. Eleven handbook lessons help along the way.',
          '좋은 힌트는 칸을 대신 채우는 데서 멈추지 않습니다. 볼 곳을 짚고, 이유를 설명하고, 확실한 칸을 보여줍니다. 열한 가지 운항 교본 수업도 함께합니다.',
        )}
      </p>
    </div>
    <div class="hint-card" data-hints>
      <div class="hint-tabs" role="tablist" aria-label={c('Hint steps', '힌트 단계')}>
        {[c('Look', '어디를 볼까요'), c('Understand', '왜 그럴까요'), c('Confirm', '확인하기')].map(
          (text, i) => (
            <button
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              id={`hint-tab-${i}`}
              aria-controls={`hint-panel-${i}`}
              tabindex={i === 0 ? 0 : -1}
              data-step={i}
            >
              {i + 1}
              <span>{text}</span>
            </button>
          ),
        )}
      </div>
      {[
        c(
          'Look at this row. Three connected cells must fit in five spaces.',
          '이 행을 보세요. 다섯 칸에 연속된 세 칸이 들어가야 합니다.',
        ),
        c(
          'Push the run to either end. The middle cell is filled in both cases.',
          '세 칸을 왼쪽과 오른쪽 끝에 놓아보면, 가운데 칸은 언제나 겹칩니다.',
        ),
        c(
          'That middle cell is certain. You found it by logic, without guessing.',
          '가운데 칸은 확실히 칠할 수 있습니다. 추측하지 않고 논리로 찾았습니다.',
        ),
      ].map((text, i) => (
        <div
          class="hint-panel"
          id={`hint-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`hint-tab-${i}`}
          hidden={i !== 0}
        >
          <span class="airdata">{i === 1 ? 'OVERLAP · T2' : c('ROW CLUE', '행 힌트')}</span>
          <div class="hint-row">
            <strong>3</strong>
            {Array.from({ length: 5 }, (_, j) => (
              <span class:list={{ certain: i === 2 && j === 2, possible: i === 1 }}>
                {i === 2 && j === 2 ? <Icon name="check" /> : ''}
              </span>
            ))}
          </div>
          {i === 1 && (
            <div class="overlap-bars" aria-hidden="true">
              <i></i>
              <i></i>
            </div>
          )}
          <p>{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="section collect-section" id="collect">
  <div class="container">
    <div class="section-heading">
      <p class="airdata accent">NOT SOUVENIRS. YOUR STORY.</p>
      <h2>{c('A journey that stays as an album.', '여정이 앨범으로 남습니다.')}</h2>
      <p>
        {c(
          'Sixteen photos per city. Thirty-six baggage tags. A passport stamped with places you’ve finished. Each one is a flight you actually took.',
          '도시마다 사진 열여섯 장. 서른여섯 가지 수하물 태그. 완주한 도시의 스탬프가 찍힌 여권. 모두 직접 떠난 비행의 기록입니다.',
        )}
      </p>
    </div>
    <div class="album">
      <div class="album-top airdata">
        <span>TRAVEL ALBUM</span>
        <span>SEOUL → HONG KONG</span>
      </div>
      <div class="album-slots">
        <div class="album-slot empty">
          <div class="corner corner-a"></div>
          <div class="corner corner-b"></div>
          <Icon name="plane" size={26} />
          <span class="airdata">{c('A PLACE TO GO', '앞으로 떠날 곳')}</span>
        </div>
        <div class="album-slot boarding">
          <div class="mini-grid" aria-hidden="true">
            {Array.from({ length: 25 }, (_, i) => (
              <i class:list={{ filled: [2, 7, 10, 11, 12, 13, 14, 17].includes(i) }} />
            ))}
          </div>
          <span class="airdata">{c('A VIEW IN PROGRESS', '만들어 가는 풍경')}</span>
        </div>
        <button
          class="album-slot flip-photo"
          aria-pressed="false"
          aria-describedby="photo-instruction"
        >
          <span class="photo-front">
            <img
              src={asset('city-hkg.avif')}
              width="400"
              height="260"
              loading="lazy"
              alt={c('Hong Kong harbour souvenir photo', '홍콩 항구 기념사진')}
            />
            <span>
              {c('Harbour lights', '항구의 불빛')}
              <small>HKG · WINDOW SEAT</small>
            </span>
          </span>
          <span class="photo-back" aria-hidden="true">
            <span class="airdata">BOARDING PASS</span>
            <strong>HKG</strong>
            <span>NT-0216</span>
            <span class="airdata">{c('A MEMORY TO KEEP', '간직하고 싶은 기억')}</span>
            <span class="barcode" aria-hidden="true"></span>
          </span>
        </button>
      </div>
      <p class="album-note caption" id="photo-instruction">
        {c(
          'An album preview. Tap the finished photo to turn it over.',
          '앨범 미리보기입니다. 완성된 사진을 눌러 뒤집어 보세요.',
        )}
      </p>
    </div>
    <div class="collection-bottom">
      <div class="tag-display">
        <span class="airdata">BAGGAGE TAGS · 36 TO COLLECT</span>
        <div class="tag-rail">
          {['ICN', 'HKG', 'SIN', 'DPS', 'CDG', 'KEF'].map((code, i) => (
            <div
              class:list={['luggage-tag', { 'tag-unearned': i > 3 }]}
              style={`--tilt:${[5, -7, 4, -4, 6, -3][i]}deg`}
            >
              <span class="tag-hole"></span>
              <Icon name={i > 3 ? 'globe' : 'plane'} size={20} />
              <strong>{code}</strong>
              <span class="barcode"></span>
              <small>
                {i > 3 ? c('TO DISCOVER', '발견할 여행') : c('A LITTLE MEMORY', '작은 여행의 기억')}
              </small>
            </div>
          ))}
        </div>
        <p class="caption">
          {c(
            'A collection preview: four earned, two still to discover.',
