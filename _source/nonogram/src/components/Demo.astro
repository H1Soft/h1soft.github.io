---
import { DEMO_5, DemoBoard, cellLabel, demoCopy, type Language } from '../scripts/demo-engine';
import '../styles/demo.css';
interface Props {
  lang: Language;
}
const { lang = 'en' } = Astro.props;
const t = demoCopy[lang];
const board = new DemoBoard(DEMO_5);
const helpId = `demo-help-${lang}`;
---

<section
  class="demo"
  data-nonogram-demo
  data-lang={lang}
  data-size="5"
  data-phase="playing"
  aria-label={t.grid}
>
  <header class="demo-heading">
    <h2>{t.heading}</h2>
    <p class="demo-flight" data-demo-meta>
      DEMO · 5 × 5 · ECONOMY
    </p>
  </header>
  <p class="demo-instruction" data-demo-instruction>
    {t.instruction}
  </p>
  <div class="demo-viewport" data-demo-viewport>
    <div class="demo-assembly" data-demo-assembly>
      <div class="demo-corner" aria-hidden="true">
        <span>01</span>
        <i></i>
      </div>
      <div class="demo-columns" data-demo-columns aria-label={t.columns}>
        {board.hints.columns.map((clue, c) => (
          <div class="demo-clue demo-column-clue" data-clue-column={c}>
            {clue.map((n) => (
              <span>{n}</span>
            ))}
          </div>
        ))}
      </div>
      <div class="demo-rows" data-demo-rows aria-label={t.rows}>
        {board.hints.rows.map((clue, r) => (
          <div class="demo-clue demo-row-clue" data-clue-row={r}>
            {clue.map((n) => (
              <span>{n}</span>
            ))}
          </div>
        ))}
      </div>
      <div class="demo-window" data-demo-window>
        <div class="demo-window-inner">
          <div
            class="demo-grid"
            data-demo-grid
            role="grid"
            aria-label={t.grid}
            aria-describedby={helpId}
            aria-rowcount="5"
            aria-colcount="5"
          >
            {Array.from({ length: 5 }, (_, r) => (
              <div role="row" class="demo-grid-row" aria-rowindex={r + 1}>
                {Array.from({ length: 5 }, (_, c) => (
                  <button
                    type="button"
                    role="gridcell"
                    class="demo-cell"
                    data-cell={r * 5 + c}
                    data-state="empty"
                    aria-disabled="true"
                    tabindex={r === 0 && c === 0 ? 0 : -1}
                    aria-colindex={c + 1}
                    aria-label={cellLabel(board, r * 5 + c, lang)}
                  >
                    <span aria-hidden="true"></span>
                  </button>
                ))}
              </div>
            ))}
          </div>
          <img
            class="demo-photo"
            data-demo-photo
            alt=""
            width="900"
            height="600"
            decoding="async"
          />
          <span class="demo-sheen" aria-hidden="true"></span>
          <div class="demo-arrival" aria-hidden="true">
            <span>ARRIVED</span>
            <strong data-demo-city>ICN</strong>
            <span>WINDOW SEAT</span>
          </div>
        </div>
        <span class="demo-seat" data-demo-seat aria-hidden="true">
          SEAT 1A
        </span>
      </div>
    </div>
  </div>
  <div class="demo-pan" data-demo-pan hidden>
    <button type="button" data-demo-pan-left aria-label={t.left}>
      ←
    </button>
    <p>{t.pan}</p>
    <button type="button" data-demo-pan-right aria-label={t.right}>
      →
    </button>
  </div>
  <div
    class="demo-tools"
    data-demo-tools
    role="group"
    aria-label={lang === 'ko' ? '퍼즐 도구' : 'Puzzle tools'}
  >
    <button
      type="button"
      class="demo-tool is-selected"
      data-demo-tool="fill"
      aria-pressed="true"
      disabled
    >
      <span class="demo-fill-icon" aria-hidden="true"></span>
      {t.fill}
    </button>
    <button type="button" class="demo-tool" data-demo-tool="mark" aria-pressed="false" disabled>
      <span aria-hidden="true">✕</span>
      {t.mark}
    </button>
    <button type="button" class="demo-undo" data-demo-undo disabled aria-label={t.undo}>
      <span aria-hidden="true">↶</span>
      <span>{t.undo}</span>
    </button>
  </div>
  <p class="demo-axis" data-demo-axis aria-hidden="true"></p>
  <div class="demo-guide" data-demo-guide id={helpId}>
    <p>{t.controls}</p>
    <details>
      <summary>{t.keyboard}</summary>
      <p>{t.keys}</p>
    </details>
    <p class="demo-rule">{t.rule}</p>
  </div>
  <button type="button" class="demo-skip" data-demo-skip hidden>
    {t.skip}
  </button>
  <div class="demo-result" data-demo-result hidden>
    <p class="demo-caption" data-demo-caption></p>
    <h3 data-demo-result-title tabindex="-1"></h3>
    <p class="demo-earned" data-demo-earned></p>
    <p>{t.more}</p>
    <a class="demo-download" href="#download" data-cta="demo_done">
      {t.explore}
      <span aria-hidden="true">↗</span>
    </a>
    <p class="demo-coming">{t.coming}</p>
    <div class="demo-result-actions">
      <button type="button" data-demo-next>
        {t.next}
        <span aria-hidden="true"> →</span>
      </button>
      <button type="button" data-demo-replay>
        {t.replay}
      </button>
    </div>
  </div>
  <p class="demo-sr-only" data-demo-live role="status" aria-live="polite" aria-atomic="true"></p>
  <noscript>
    <p class="demo-noscript">{t.nojs}</p>
  </noscript>
</section>
<script>
  import '../scripts/demo';
</script>
