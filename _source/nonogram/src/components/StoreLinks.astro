---
import { stores, type Lang } from '../data/site';
import { localizeStoreUrl } from '../../../../js/store-links.mjs';
const { lang = 'en', position = 'hero' } = Astro.props as { lang: Lang; position?: string };
const list = [
  { name: 'Google Play', url: stores.google, os: 'android' },
  { name: 'App Store', url: stores.apple, os: 'ios' },
];
---

<div class="store-links" data-position={position}>
  {list.map((s) => {
    const Tag = s.url ? 'a' : 'span';
    return (
      <Tag
        class:list={['store-link', { upcoming: !s.url }]}
        href={s.url ? localizeStoreUrl(s.url, lang) : undefined}
        data-store={s.os}
        rel={s.url ? 'noopener' : undefined}
      >
        {s.os === 'ios' ? (
          <svg class="store-link__icon" width="20" height="24" viewBox="0 0 20 24" aria-hidden="true">
            <path d="M16.4 12.7c0-2.6 2.1-3.9 2.2-4-1.2-1.8-3.1-2-3.8-2.1-1.6-.2-3.1 1-3.9 1-.8 0-2.1-.9-3.4-.9-1.8 0-3.4 1-4.3 2.6-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.3 2.6 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8c1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-2.9 1.4-3-.1 0-2.8-1.1-2.8-4.1zM13.8 3.5c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.1.1 2.3-.6 3-1.5z" fill="#fff" />
          </svg>
        ) : (
          <svg class="store-link__icon" width="19" height="21" viewBox="0 0 24 26" aria-hidden="true">
            <path d="M3 2.2v21.6L14.3 13 3 2.2z" fill="#00C4FF" />
            <path d="M3 2.2L14.3 13l3.8-3.7L4.6 1.5C4 .1 3 .8 3 2.2z" fill="#00E064" />
            <path d="M3 23.8c0 1.4 1 2.1 1.6.7l13.5-7.8-3.8-3.7L3 23.8z" fill="#FF3A44" />
            <path d="M18.1 9.3L14.3 13l3.8 3.7 3.4-2c1.1-.6 1.1-2.8 0-3.4l-3.4-2z" fill="#FFCE00" />
          </svg>
        )}
        <span class="store-link__text">
          <small>{s.url ? (lang === 'ko' ? '다운로드' : 'Download on') : (lang === 'ko' ? '출시 예정' : 'COMING SOON')}</small>
          <strong>{s.name}</strong>
        </span>
      </Tag>
    );
  })}
</div>
