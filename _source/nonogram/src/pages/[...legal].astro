---
import Layout from '../layouts/Layout.astro';
import Legal from '../components/Legal.astro';
import { legal } from '../data/legal';
import { origin, page } from '../data/site';
export function getStaticPaths() {
  return (['en', 'ko'] as const).flatMap((lang) =>
    (['privacy', 'terms', 'support'] as const).map((slug) => ({
      params: { legal: `${lang === 'ko' ? 'ko/' : ''}${slug}` },
      props: { lang, slug },
    })),
  );
}
const { lang, slug } = Astro.props;
const content = legal[lang][slug];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nonogram Trip', item: origin + page(lang) },
      { '@type': 'ListItem', position: 2, name: content.title, item: origin + page(lang, slug) },
    ],
  },
];
---

<Layout
  lang={lang}
  slug={slug}
  title={`${content.title} — Nonogram Trip`}
  description={content.description}
  schema={schema}
>
  <Legal lang={lang} slug={slug} />
</Layout>
