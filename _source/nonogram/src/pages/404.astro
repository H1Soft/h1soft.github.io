---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="en"
  title="Flight not found — Nonogram Trip"
  description="This flight has changed gates. Return to Nonogram Trip and find your next puzzle."
  noindex
>
  <div class="container not-found">
    <p class="airdata accent">404 · FLIGHT NOT FOUND</p>
    <h1>This flight has changed gates.</h1>
    <p>The page you’re looking for isn’t here. Your next window seat is.</p>
    <a class="button" href="/nonogram/">
      Back to Nonogram Trip
    </a>{' '}
    <a class="text-link" href="/nonogram/ko/" lang="ko">
      한국어 홈으로
    </a>
  </div>
</Layout>
