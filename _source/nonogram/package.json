{
  "name": "nonogram-trip-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "npm run build && npm run test:build",
    "test:browser": "playwright test tests/site.spec.ts tests/compatibility.spec.ts --workers=1",
    "test:build": "python3 scripts/verify-build.py",
    "format": "prettier --write src tests scripts/*.mjs astro.config.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "lighthouse": "latest",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
